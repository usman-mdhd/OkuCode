{
  "name": "okucode",
  "displayName": "OkuCode",
  "description": "OkuCode, the Okutobus AI coding agent, inside VS Code: chat panel, approvals and diffs",
  "version": "0.2.1",
  "publisher": "okutobus",
  "repository": {
    "type": "git",
    "url": "https://github.com/OKUTOBUS-TECH/okucode-cli"
  },
  "license": "MIT",
  "icon": "images/icon.png",
  "engines": {
    "vscode": "^1.94.0"
  },
  "categories": [
    "AI",
    "Programming Languages",
    "Other"
  ],
  "activationEvents": [],
  "main": "./dist/extension.js",
  "contributes": {
    "commands": [
      {
        "command": "okucode.focusChat",
        "title": "OkuCode: Open Chat",
        "icon": "$(comment-discussion)"
      },
      {
        "command": "okucode.addToChat",
        "title": "OkuCode: Add File to Chat"
      },
      {
        "command": "okucode.openTerminal",
        "title": "OkuCode: Open in Terminal",
        "icon": {
          "light": "images/button-dark.svg",
          "dark": "images/button-light.svg"
        }
      },
      {
        "command": "okucode.openNewTerminal",
        "title": "OkuCode: Open in New Tab",
        "icon": {
          "light": "images/button-dark.svg",
          "dark": "images/button-light.svg"
        }
      },
      {
        "command": "okucode.openChatPanel",
        "title": "OkuCode: Open Web App"
      },
      {
        "command": "okucode.addFilepathToTerminal",
        "title": "OkuCode: Add File to Terminal"
      },
      {
        "command": "okucode.askAboutFile",
        "title": "Ask OkuCode about this"
      }
    ],
    "menus": {
      "editor/title": [
        {
          "command": "okucode.openNewTerminal",
          "group": "navigation"
        }
      ],
      "editor/context": [
        {
          "command": "okucode.askAboutFile",
          "group": "okucode@1"
        },
        {
          "command": "okucode.addToChat",
          "group": "okucode@2"
        }
      ],
      "explorer/context": [
        {
          "command": "okucode.askAboutFile",
          "when": "!explorerResourceIsFolder",
          "group": "okucode@1"
        }
      ]
    },
    "keybindings": [
      {
        "command": "okucode.openTerminal",
        "key": "ctrl+escape",
        "mac": "cmd+escape"
      },
      {
        "command": "okucode.openNewTerminal",
        "key": "ctrl+shift+escape",
        "mac": "cmd+shift+escape"
      },
      {
        "command": "okucode.addToChat",
        "key": "ctrl+alt+k",
        "mac": "cmd+alt+k"
      },
      {
        "command": "okucode.focusChat",
        "key": "ctrl+alt+o",
        "mac": "cmd+alt+o"
      }
    ],
    "configuration": {
      "title": "OkuCode",
      "properties": {
        "okucode.command": {
          "type": "string",
          "default": "okucode",
          "description": "Command that starts OkuCode (use the full path if VS Code cannot find it, e.g. /Users/you/Projects/okucode-cli/bin/okucode)."
        },
        "okucode.port": {
          "type": "number",
          "default": 4096,
          "description": "Port of the OkuCode web app (okucode web), used by \"OkuCode: Open Web App\"."
        },
        "okucode.panelPort": {
          "type": "number",
          "default": 4097,
          "description": "Port of the background OkuCode server the chat panel starts (okucode serve)."
        },
        "okucode.showDiffs": {
          "type": "boolean",
          "default": true,
          "description": "Open a diff (before \u2194 after) whenever OkuCode changes a file."
        }
      }
    },
    "viewsContainers": {
      "activitybar": [
        {
          "id": "okucode",
          "title": "OkuCode",
          "icon": "images/activity.svg"
        }
      ]
    },
    "views": {
      "okucode": [
        {
          "type": "webview",
          "id": "okucode.chat",
          "name": "Chat"
        }
      ]
    }
  },
  "scripts": {
    "vscode:prepublish": "bun run package",
    "compile": "bun run check-types && bun run lint && node esbuild.js",
    "watch:esbuild": "node esbuild.js --watch",
    "watch:tsc": "tsc --noEmit --watch --project tsconfig.json",
    "package": "bun run check-types && bun run lint && node esbuild.js --production",
    "compile-tests": "tsc -p . --outDir out",
    "watch-tests": "tsc -p . -w --outDir out",
    "pretest": "bun run compile-tests && bun run compile && bun run lint",
    "check-types": "tsc --noEmit",
    "lint": "eslint src",
    "test": "vscode-test"
  },
  "devDependencies": {
    "@types/vscode": "^1.94.0",
    "@types/mocha": "^10.0.10",
    "@types/node": "20.x",
    "@typescript-eslint/eslint-plugin": "^8.31.1",
    "@typescript-eslint/parser": "^8.31.1",
    "eslint": "^9.25.1",
    "esbuild": "^0.25.3",
    "typescript": "^5.8.3",
    "@vscode/test-cli": "^0.0.11",
    "@vscode/test-electron": "^2.5.2"
  }
}
