#!/bin/sh
# OkuCode (Okutobus Technologies) — run the CLI from this source checkout.
# Usage: add this folder's bin/ to PATH, then run `okucode` from any project directory.
#
#   okucode                 terminal UI in the current folder
#   okucode web [--port N]  web UI + API on this laptop (http://127.0.0.1:4096 by default)
#   okucode serve           API server only (see `okucode serve --help`)
#   okucode update          update OkuCode (installed with okutobus/install.sh)
#   okucode sandbox-image   build the Docker sandbox image (FR-25)
#   okucode gateway ...     the team model gateway (FR-45): setup, start, status, key, connect
#   okucode review ...      review this branch's changes, or post the review on a GitHub pull request (FR-32)
set -e
SELF="$0"
while [ -L "$SELF" ]; do
  LINK="$(readlink "$SELF")"
  case "$LINK" in /*) SELF="$LINK" ;; *) SELF="$(dirname "$SELF")/$LINK" ;; esac
done
ROOT="$(cd "$(dirname "$SELF")/.." && pwd)"
CLI="$ROOT/packages/cli"
APP="$ROOT/packages/app"
PRELOAD="$CLI/node_modules/@opentui/solid/scripts/preload.js"
# The installer (okutobus/install.sh) puts the Bun version OkuCode needs in ~/.okucode/bun.
if [ -x "$HOME/.okucode/bun/bin/bun" ]; then PATH="$HOME/.okucode/bun/bin:$PATH"; export PATH; fi

# okucode sandbox-image: build the Docker image for the Docker sandbox (FR-25; "sandbox": "docker" in okucode.json).
if [ "$1" = "sandbox-image" ]; then
  command -v docker >/dev/null 2>&1 || { echo "okucode: Docker is not installed. Get Docker Desktop: https://www.docker.com/products/docker-desktop/" >&2; exit 1; }
  docker info >/dev/null 2>&1 || { echo "okucode: Docker is not running. Start Docker Desktop and try again." >&2; exit 1; }
  IMAGE="${2:-okucode-sandbox}"
  echo "okucode: building the sandbox image $IMAGE (a few minutes the first time)..."
  docker build -t "$IMAGE" "$ROOT/okutobus/sandbox" && echo "okucode: done. Choose Docker in Settings → Team → Sandbox for Full-auto."
  exit $?
fi

# okucode review: review this branch's changes with the team's model (FR-32; FR-55 runs it in GitHub Actions).
if [ "$1" = "review" ]; then
  shift
  exec bun "$ROOT/okutobus/review/review.ts" "$@"
fi

# okucode gateway: the team model gateway (FR-45, LiteLLM). See okutobus/gateway/README.md.
if [ "$1" = "gateway" ]; then
  shift
  GW="$HOME/.okucode/gateway"
  case "${1:-}" in
    setup) shift; exec bash "$ROOT/okutobus/gateway/setup.sh" "$@" ;;
    start)
      shift
      [ -x "$GW/venv/bin/litellm" ] || { echo "okucode: the gateway is not set up yet. Run: okucode gateway setup" >&2; exit 1; }
      HOST=127.0.0.1; GWPORT=4000
      while [ $# -gt 0 ]; do
        case "$1" in
          --host) HOST="${2:?}"; shift 2 ;;
          --port) GWPORT="${2:?}"; shift 2 ;;
          *) echo "okucode: unknown option $1 (use --host or --port)" >&2; exit 1 ;;
        esac
      done
      set -a; . "$GW/gateway.env"; set +a
      echo "okucode: gateway on http://$HOST:$GWPORT (models from $OKUCODE_MODEL_SERVER). Stop: Ctrl+C"
      exec "$GW/venv/bin/litellm" --config "$GW/config.yaml" --host "$HOST" --port "$GWPORT"
      ;;
    status)
      URL="${2:-http://127.0.0.1:4000}"
      if curl -fsS -m 5 "$URL/health/liveliness" >/dev/null 2>&1; then echo "okucode: the gateway at $URL is running"; else echo "okucode: no gateway answering at $URL" >&2; exit 1; fi
      exit 0
      ;;
    key)
      [ -s "$GW/gateway.env" ] || { echo "okucode: no key yet. Run: okucode gateway setup" >&2; exit 1; }
      sed -n 's/^OKUCODE_GATEWAY_KEY=//p' "$GW/gateway.env"
      exit 0
      ;;
    connect)
      shift
      [ -f "$PRELOAD" ] || { echo "okucode: dependencies missing. Run: (cd \"$ROOT\" && bun install)" >&2; exit 1; }
      exec bun "$ROOT/okutobus/gateway/connect.ts" "$@"
      ;;
    *)
      echo "okucode gateway setup [--models <address>] [--service]   install LiteLLM and make the key"
      echo "okucode gateway start [--host 0.0.0.0] [--port 4000]      run the gateway"
      echo "okucode gateway status [address]                        is it running?"
      echo "okucode gateway key                                     show the key"
      echo "okucode gateway connect <address> <key>                 use the gateway in OkuCode on this computer"
      [ -z "${1:-}" ] && exit 0 || exit 1
      ;;
  esac
fi

# okucode update: get the latest version (or, for your own clone, reinstall its packages and rebuild).
if [ "$1" = "update" ]; then
  shift
  if [ "$ROOT" = "$HOME/.okucode/app" ]; then exec bash "$ROOT/okutobus/install.sh" "$@"; fi
  echo "okucode: this is your own folder ($ROOT). Get changes with git (git pull or git am), then this reinstalls the packages."
  exec bash "$ROOT/okutobus/install.sh" --from "$ROOT" "$@"
fi

if [ ! -f "$PRELOAD" ]; then
  echo "okucode: dependencies missing. Run: (cd \"$ROOT\" && bun install)" >&2
  exit 1
fi

if [ "$1" = "web" ]; then
  shift
  PORT=4096
  if [ "$1" = "--port" ] && [ -n "$2" ]; then PORT="$2"; shift 2; fi

  # Build the web UI on first use, and again whenever its source changed.
  if [ ! -f "$APP/dist/index.html" ] || [ -n "$(find "$APP/src" "$APP/index.html" "$APP"/vite*.ts "$ROOT/packages/ui/src" "$ROOT/packages/session-ui/src" -newer "$APP/dist/index.html" -print 2>/dev/null | head -1)" ]; then
    echo "okucode: building the web UI (first time or after an update, about 1 minute)..."
    (cd "$APP" && bun run build >/dev/null) || { echo "okucode: web UI build failed. Run: cd \"$APP\" && bun run build" >&2; exit 1; }
  fi

  # If an older `okucode web` is still running on this port (e.g. in another terminal tab), stop it.
  if command -v lsof >/dev/null 2>&1; then
    for OLD in $(lsof -ti "tcp:$PORT" -sTCP:LISTEN 2>/dev/null); do
      if ps -o command= -p "$OLD" 2>/dev/null | grep -q "src/index.ts serve"; then
        echo "okucode: stopping the old OkuCode web that was still running on port $PORT..."
        kill "$OLD" 2>/dev/null || true
      else
        echo "okucode: port $PORT is used by another program. Try: okucode web --port $((PORT + 1))" >&2
        exit 1
      fi
    done
    sleep 1
  fi

  # Default folder for normal chats (the home screen uses it when no project is added yet).
  mkdir -p "$HOME/OkuCode-Chats" 2>/dev/null || true

  # The password is kept between runs (in ~/.okucode/web-password) so Google sign-ins stay signed in after a restart.
  PASSWORD="${OKUCODE_PASSWORD:-${OPENCODE_PASSWORD:-}}"
  PASSWORD_FILE="$HOME/.okucode/web-password"
  if [ -z "$PASSWORD" ] && [ -s "$PASSWORD_FILE" ]; then PASSWORD="$(cat "$PASSWORD_FILE")"; fi
  if [ -z "$PASSWORD" ]; then
    PASSWORD="$(LC_ALL=C tr -dc 'a-z0-9' </dev/urandom | head -c 12)"
    mkdir -p "$HOME/.okucode" && (umask 077 && printf '%s' "$PASSWORD" > "$PASSWORD_FILE")
  fi
  URL="http://localhost:$PORT"
  echo ""
  echo "  OkuCode web UI + API (this laptop only)"
  echo "  ---------------------------------------"
  echo "  Open:      $URL"
  echo "  Password:  $PASSWORD"
  echo "  Admin:     $URL/okucode/admin"
  echo "  API docs:  $URL/openapi.json   (user: opencode, password above)"
  echo "  Stop:      press Ctrl+C"
  echo ""
  if command -v open >/dev/null 2>&1; then (sleep 3 && open "$URL") >/dev/null 2>&1 &
  elif command -v xdg-open >/dev/null 2>&1; then (sleep 3 && xdg-open "$URL") >/dev/null 2>&1 &
  fi
  cd "$HOME/OkuCode-Chats" 2>/dev/null || true
  OPENCODE_PASSWORD="$PASSWORD" exec bun --preload "$PRELOAD" "$CLI/src/index.ts" serve --hostname 127.0.0.1 --port "$PORT" "$@"
fi

exec bun --preload "$PRELOAD" "$CLI/src/index.ts" "$@"
